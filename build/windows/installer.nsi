
; easyinstaller - Generated by build.py
; Project: Easy Diffusion v2.5

!include "MUI2.nsh"

Name "Easy Diffusion"
OutFile "Easy Diffusion-2.5-installer.exe"
InstallDir "C:\EasyDiffusion"

!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

Section "Install"
  SetOutPath "$INSTDIR"
  File /r "*.*"
  CreateShortcut "$SMPROGRAMS\Easy Diffusion.lnk" "$INSTDIR\Start Stable Diffusion UI.cmd"
SectionEnd

Section "Uninstall"
  RMDir /r "$INSTDIR"
  Delete "$SMPROGRAMS\Easy Diffusion.lnk"
SectionEnd
